rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPrincipalAdmin() {
      return signedIn()
        && request.auth.token.email == 'asmaabd1987@gmail.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/userProfiles/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function hasActiveProfile() {
      return hasProfile()
        && (!profile().keys().hasAny(['active']) || profile().active == true)
        && (!profile().keys().hasAny(['deleted']) || profile().deleted != true);
    }

    function isAdmin() {
      return isPrincipalAdmin()
        || (hasActiveProfile() && profile().role == 'admin');
    }

    function hasStockPermission() {
      return hasActiveProfile()
        && profile().keys().hasAll(['permissions'])
        && profile().permissions.keys().hasAll(['stock'])
        && profile().permissions.stock == true;
    }

    function hasExpensesPermission() {
      return hasActiveProfile()
        && profile().keys().hasAll(['permissions'])
        && profile().permissions.keys().hasAll(['expenses'])
        && profile().permissions.expenses == true;
    }

    function hasShiftClosingPermission() {
      return hasActiveProfile()
        && profile().keys().hasAll(['permissions'])
        && profile().permissions.keys().hasAll(['shiftClosings'])
        && profile().permissions.shiftClosings == true;
    }

    function isActiveEmployee() {
      return hasActiveProfile() && profile().role == 'employee';
    }

    function canAccessDataset(dataset) {
      return isAdmin()
        || (
          hasStockPermission()
          && (
            dataset == 'products'
            || dataset == 'movements'
            || dataset == 'inventories'
            || dataset == 'stockLosses'
          )
        )
        || (hasExpensesPermission() && dataset == 'expenses');
    }

    function validDatasetWrite() {
      return request.resource.data.items is list
        && request.resource.data.updatedBy == request.auth.uid;
    }


    function validRecordV2Write() {
      return request.resource.data.keys().hasAll(['id', '_cloudUpdatedBy'])
        && request.resource.data._cloudUpdatedBy == request.auth.uid;
    }

    function isOwnProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSafeSelfProfileUpdate(uid) {
      return isOwnProfile(uid)
        && hasActiveProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastLoginAt']);
    }

    function canCreateAudit() {
      return hasActiveProfile()
        && request.resource.data.user.uid == request.auth.uid
        && (
          isAdmin()
          || request.resource.data.module == 'security'
          || (request.resource.data.module == 'stock' && hasStockPermission())
          || (request.resource.data.module == 'expenses' && hasExpensesPermission())
          || (request.resource.data.module == 'shiftClosings' && hasShiftClosingPermission())
        );
    }

    function validShiftClosing() {
      return request.resource.data.keys().hasAll([
          'id', 'date', 'shift', 'employeeUid', 'employeeName',
          'systemRevenue', 'tpe', 'expenses', 'other', 'cashBalance',
          'employeeUsername', 'otherLabel', 'notes',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.shift in ['morning', 'evening', 'full-day']
        && request.resource.data.employeeUid is string
        && request.resource.data.employeeName is string
        && request.resource.data.employeeName.size() <= 120
        && request.resource.data.employeeUsername is string
        && request.resource.data.otherLabel is string
        && request.resource.data.otherLabel.size() <= 160
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.systemRevenue is number
        && request.resource.data.systemRevenue >= 0
        && request.resource.data.systemRevenue <= 100000000
        && request.resource.data.tpe is number
        && request.resource.data.tpe >= 0
        && request.resource.data.tpe <= 100000000
        && request.resource.data.expenses is number
        && request.resource.data.expenses >= 0
        && request.resource.data.expenses <= 100000000
        && request.resource.data.other is number
        && request.resource.data.other >= 0
        && request.resource.data.other <= 100000000
        && request.resource.data.cashBalance is number
        && request.resource.data.cashBalance >= -100000000
        && request.resource.data.cashBalance <= 100000000
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /companies/{companyId}/data/{dataset} {
      allow read: if companyId == 'pause-plate-manager'
        && canAccessDataset(dataset);
      allow create, update: if companyId == 'pause-plate-manager'
        && canAccessDataset(dataset)
        && validDatasetWrite();
      allow delete: if companyId == 'pause-plate-manager' && isAdmin();
    }

    match /companies/{companyId}/meta/{documentId} {
      allow get: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasActiveProfile());
      allow list: if false;
      allow create, update, delete: if companyId == 'pause-plate-manager' && isAdmin();
    }

    match /companies/{companyId}/products/{recordId} {
      allow read: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission());
      allow create, update: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission())
        && validRecordV2Write();
      allow delete: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission());
    }

    match /companies/{companyId}/movements/{recordId} {
      allow read: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission());
      allow create, update: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission())
        && validRecordV2Write();
      allow delete: if companyId == 'pause-plate-manager'
        && (isAdmin() || hasStockPermission());
    }

    match /companies/{companyId}/shiftClosings/{shiftId} {
      allow read: if companyId == 'pause-plate-manager'
        && (
          isAdmin()
          || (hasShiftClosingPermission() && resource.data.employeeUid == request.auth.uid)
        );

      allow create: if companyId == 'pause-plate-manager'
        && validShiftClosing()
        && request.resource.data.id == shiftId
        && (
          isAdmin()
          || (
            hasShiftClosingPermission()
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
          )
        );

      allow update: if companyId == 'pause-plate-manager'
        && validShiftClosing()
        && request.resource.data.id == shiftId
        && (
          isAdmin()
          || (
            hasShiftClosingPermission()
            && resource.data.employeeUid == request.auth.uid
            && request.resource.data.employeeUid == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );

      allow delete: if companyId == 'pause-plate-manager' && isAdmin();
    }

    match /userProfiles/{uid} {
      allow get: if isOwnProfile(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || isSafeSelfProfileUpdate(uid);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isOwnProfile(uid) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if canCreateAudit();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
